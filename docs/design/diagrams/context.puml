@startuml
!theme plain
skinparam defaultFontName "DejaVu Sans"
skinparam backgroundColor #FFFFFF
skinparam componentStyle rectangle
skinparam shadowing false

title Контекстная диаграмма сервиса «КиноВектор»

actor "Гость" as Guest
actor "Зритель" as Viewer
actor "Модератор" as Moderator
actor "Администратор\nкаталога" as Admin
actor "Аналитик" as Analyst

rectangle "КиноВектор" as System {
  component "Web-интерфейс" as Web
  component "REST API" as API
  component "Каталог\nи оценки" as Catalog
  component "Рецензии\nи модерация" as Reviews
  component "История\nпросмотров" as History
  component "Рекомендательный\nмодуль" as Recommender
  component "Администрирование\nкаталога" as AdminModule

  Web --> API
  API --> Catalog
  API --> Reviews
  API --> History
  API --> Recommender
  API --> AdminModule
}

cloud "TMDB API" as TMDB
queue "SMTP-сервис" as SMTP
database "Объектное\nхранилище" as Storage
database "PostgreSQL" as DB
database "Redis" as Cache

Guest --> Web
Viewer --> Web
Moderator --> Web
Admin --> Web
Analyst --> Web

AdminModule --> TMDB : метаданные
Catalog --> Storage : постеры
API --> SMTP : письма
Catalog --> DB
Reviews --> DB
History --> DB
Recommender --> DB
Recommender --> Cache
AdminModule --> DB

@enduml
